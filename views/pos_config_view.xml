<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_netpay" model="ir.ui.view">
        <field name="name">pos.config.form.netpay</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='company']" position="after">
                <group string="Netpay">
                    <field name="netpay_api_base"/>
                    <field name="netpay_client_id"/>
                    <field name="netpay_client_secret"/>
                    <field name="serial_number"/>
                    <field name="store_id_netpay"/>
                    <field name="access_token" groups="base.group_system"/>
                    <field name="refresh_token" groups="base.group_system"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
