<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_form_inherit_netpay" model="ir.ui.view">
        <field name="name">pos.payment.method.form.netpay</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.view_payment_method_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Netpay">
                    <field name="netpay_test_mode"/>
                    <field name="netpay_api_base"/>
                    <field name="netpay_terminal_identifier"/>
                    <field name="terminal_api_key"/>
                    <field name="terminal_api_pwd"/>
                    <field name="terminal_id"/>
                    <field name="administrators_only"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>