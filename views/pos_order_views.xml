<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_netpay" model="ir.ui.view">
        <field name="name">pos.order.form.netpay</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Netpay">
                    <field name="order_netpay_id"/>
                    <field name="netpaystatus"/>
                    <field name="reprint_netpay"/>
                    <field name="order_cancel_netpay"/>
                    <field name="cancel_hour"/>
                    <field name="reprint_time"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>